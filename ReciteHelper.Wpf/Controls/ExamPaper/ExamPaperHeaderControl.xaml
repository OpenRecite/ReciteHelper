<UserControl
    x:Class="ReciteHelper.Wpf.Controls.ExamPaper.ExamPaperHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,24">
            <TextBlock
                HorizontalAlignment="Left"
                FontFamily="Times New Roman,SimHei"
                FontSize="14"
                FontWeight="Bold"
                Text="参照秘密级管理★启用前" />
            <TextBlock
                HorizontalAlignment="Right"
                FontFamily="Times New Roman,SimHei"
                FontSize="14"
                FontWeight="Bold"
                Text="试卷类型：A" />
        </Grid>

        <TextBlock
            x:Name="ExamTitleText"
            HorizontalAlignment="Center"
            FontFamily="Times New Roman,SimSun"
            FontSize="21.333"
            FontWeight="Normal"
            LineHeight="28"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="SubjectText"
            Margin="0,2,0,12"
            HorizontalAlignment="Center"
            FontFamily="Times New Roman,SimHei"
            FontSize="29"
            FontWeight="Bold"
            TextAlignment="Center" />

        <TextBlock
            Margin="0,5,0,5"
            FontFamily="Times New Roman,SimHei"
            FontSize="16"
            FontWeight="Bold"
            Text="注意事项：" />
        <TextBlock
            FontFamily="Times New Roman,SimSun"
            FontSize="16"
            LineHeight="24"
            Text="1. 答题前，请填写姓名和准考证号，并认真核对试卷类型与科目名称。&#x0a;2. 选择题选出答案后直接点击相应选项；解答题应写出必要的文字说明和作答过程。&#x0a;3. 考试过程中请勿关闭窗口；考试结束或时间用尽后，系统将统一交卷。"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
