<UserControl
    x:Class="ReciteHelper.Wpf.Controls.ExamPaper.ExamSectionHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,10,0,9">
        <TextBlock
            FontFamily="Times New Roman,SimHei"
            FontSize="16"
            LineHeight="24"
            TextWrapping="Wrap">
            <Run x:Name="TitleRun" FontWeight="Bold" />
            <Run x:Name="DescriptionRun" />
        </TextBlock>
    </StackPanel>
</UserControl>
