<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Base styles  -->
    <Style x:Key="BaseAnswerCardStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Unanswered styles  -->
    <Style
        x:Key="NotAnsweredCardStyle"
        BasedOn="{StaticResource BaseAnswerCardStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--  Correct styles  -->
    <Style
        x:Key="CorrectAnswerCardStyle"
        BasedOn="{StaticResource BaseAnswerCardStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SuccessLightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--  Error styles  -->
    <Style
        x:Key="WrongAnswerCardStyle"
        BasedOn="{StaticResource BaseAnswerCardStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ErrorLightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--  Current styles  -->
    <Style
        x:Key="CurrentQuestionCardStyle"
        BasedOn="{StaticResource BaseAnswerCardStyle}"
        TargetType="Button">
        <Setter Property="BorderBrush" Value="#FF2196F3" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>

</ResourceDictionary>