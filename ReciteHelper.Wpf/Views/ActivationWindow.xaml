<Window
    x:Class="ReciteHelper.Wpf.Views.ActivationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="选择模型服务"
    Width="1120"
    Height="650"
    MinWidth="1040"
    MinHeight="610"
    Background="#F5F7FA"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#007ACC" />
            <Setter Property="BorderBrush" Value="#007ACC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Foreground" Value="#334155" />
        </Style>
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,15,0,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
        </Style>
        <Style x:Key="OptionCard" TargetType="Border">
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DEE5ED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="#0F172A"
                Text="选择一种模型服务" />
            <TextBlock
                Margin="0,9,0,0"
                FontSize="14"
                Foreground="#64748B"
                Text="ReciteHelper 需要文本生成与向量模型。完成任意一种配置后即可继续使用。" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,25,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource OptionCard}">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="DeepSeek + Qwen" />
                    <TextBlock
                        Margin="0,9,0,0"
                        FontSize="13"
                        Foreground="#64748B"
                        LineHeight="20"
                        Text="直连两家服务，速度更快。DeepSeek 用于内容生成，Qwen 用于知识库向量。"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="DeepSeek API Key" />
                    <PasswordBox x:Name="DeepSeekKeyBox" Style="{StaticResource ModernPasswordBox}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Qwen API Key" />
                    <PasswordBox x:Name="QwenKeyBox" Style="{StaticResource ModernPasswordBox}" />
                    <Button
                        Margin="0,22,0,0"
                        HorizontalAlignment="Stretch"
                        Click="SaveDirectKeysButton_Click"
                        Content="保存并使用直连方案"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="#70B7E8" BorderThickness="2" Style="{StaticResource OptionCard}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="OpenRouter" />
                        <Border Margin="10,0,0,0" Padding="8,3" Background="#E0F2FE" CornerRadius="10">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#0369A1" Text="一把 Key" />
                        </Border>
                    </DockPanel>
                    <TextBlock
                        Margin="0,9,0,0"
                        FontSize="13"
                        Foreground="#64748B"
                        LineHeight="20"
                        Text="配置最简单。聊天与向量请求统一通过 OpenRouter，可能比直连稍慢。"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="OpenRouter API Key" />
                    <PasswordBox x:Name="OpenRouterKeyBox" Style="{StaticResource ModernPasswordBox}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="12"
                        Foreground="#94A3B8"
                        LineHeight="18"
                        Text="默认使用 DeepSeek V3.2 与 BGE-M3；模型名称可在 Config.xml 中调整。"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,22,0,0"
                        HorizontalAlignment="Stretch"
                        Click="SaveOpenRouterButton_Click"
                        Content="保存并使用 OpenRouter"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource OptionCard}">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="一站式服务" />
                    <TextBlock
                        Margin="0,9,0,0"
                        FontSize="13"
                        Foreground="#64748B"
                        LineHeight="20"
                        Text="适合不想管理 API Key 的用户。输入激活码，由 ReciteHelper 服务器提供模型能力。"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="激活码" />
                    <TextBox
                        x:Name="ActivationCodeTextBox"
                        CharacterCasing="Upper"
                        Style="{StaticResource ModernTextBox}" />
                    <Button
                        x:Name="ActivateButton"
                        Margin="0,22,0,0"
                        HorizontalAlignment="Stretch"
                        Click="ActivateButton_Click"
                        Content="验证并激活"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#64748B"
                Text="API Key 将保存在本机 Config.xml 中。" />
            <Button
                Grid.Column="1"
                Click="OpenConfigButton_Click"
                Content="高级配置"
                Style="{StaticResource SecondaryButtonStyle}" />
            <Button
                Grid.Column="3"
                Click="ExitButton_Click"
                Content="退出"
                Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
