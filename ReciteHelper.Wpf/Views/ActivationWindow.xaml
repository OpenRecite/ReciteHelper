<Window
    x:Class="ReciteHelper.Wpf.Views.ActivationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="启用 ReciteHelper"
    Width="720"
    Height="520"
    MinWidth="680"
    MinHeight="500"
    Background="#F5F7FA"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#007ACC" />
            <Setter Property="BorderBrush" Value="#007ACC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D2DAE5" />
            <Setter Property="Foreground" Value="#2F3A45" />
        </Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CDD6E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="#1E293B"
                Text="需要完成模型服务配置" />
            <TextBlock
                Margin="0,10,0,0"
                FontSize="14"
                Foreground="#64748B"
                LineHeight="22"
                Text="未检测到可用的 DeepSeek/Qwen API Key，也没有有效的一站式服务授权。请选择一种方式启用软件。"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,26,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="20"
                Background="White"
                BorderBrush="#E1E7EF"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="#0F172A"
                        Text="填写自己的 API Key" />
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="13"
                        Foreground="#64748B"
                        LineHeight="21"
                        Text="免费使用，调用费用由你的 DeepSeek 与 Qwen 账户承担。需要自行获取 Key，并在配置文件中填写 DeepSeekKey 和 QwenKey。"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,24,0,0"
                        HorizontalAlignment="Left"
                        Click="OpenConfigButton_Click"
                        Content="打开 Config.xml"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <TextBlock
                        Margin="0,14,0,0"
                        FontSize="12"
                        Foreground="#94A3B8"
                        Text="填写保存后请重新启动软件。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="2"
                Padding="20"
                Background="White"
                BorderBrush="#D8E8F8"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="#0F172A"
                        Text="激活一站式服务" />
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="13"
                        Foreground="#64748B"
                        LineHeight="21"
                        Text="适合普通用户。输入激活码后，软件会通过 ReciteHelper 服务端完成内容提取、题目生成和知识库向量生成。"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,22,0,7"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#334155"
                        Text="激活码" />
                    <TextBox
                        x:Name="ActivationCodeTextBox"
                        CharacterCasing="Upper"
                        Style="{StaticResource ModernTextBox}" />
                    <Button
                        x:Name="ActivateButton"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Click="ActivateButton_Click"
                        Content="立即激活"
                        Style="{StaticResource PrimaryButtonStyle}" />
                    <TextBlock
                        x:Name="StatusText"
                        Margin="0,14,0,0"
                        FontSize="12"
                        Foreground="#64748B"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,22,0,0" LastChildFill="False">
            <TextBlock
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                FontSize="12"
                Foreground="#94A3B8"
                Text="未完成配置时，涉及内容提取和向量生成的功能不可用。" />
            <Button
                DockPanel.Dock="Right"
                Click="ExitButton_Click"
                Content="退出"
                Style="{StaticResource SecondaryButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
