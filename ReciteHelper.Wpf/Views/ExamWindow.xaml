<Window
    x:Class="ReciteHelper.Wpf.Views.ExamWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:paper="clr-namespace:ReciteHelper.Wpf.Controls.ExamPaper"
    Title="模拟考试 - ReciteHelper"
    MinWidth="1180"
    MinHeight="760"
    Background="#D8D6D1"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CACACA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#252525" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F1F1" />
                    <Setter Property="BorderBrush" Value="#8E8E8E" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SubmitButtonStyle"
            BasedOn="{StaticResource ToolbarButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#A61F2B" />
            <Setter Property="BorderBrush" Value="#A61F2B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="78" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#861722" />
                    <Setter Property="BorderBrush" Value="#861722" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="#F8F8F7"
            BorderBrush="#BDBDBA"
            BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="ToolbarTitleText"
                        FontFamily="Times New Roman,SimHei"
                        FontSize="15"
                        FontWeight="Bold" />
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <TextBlock
                            FontFamily="Times New Roman,SimSun"
                            FontSize="12"
                            Foreground="#555555"
                            Text="考生：" />
                        <TextBlock
                            x:Name="StudentNameText"
                            FontFamily="Times New Roman,SimSun"
                            FontSize="12"
                            Foreground="#333333" />
                        <TextBlock
                            Margin="14,0,0,0"
                            FontFamily="Times New Roman,SimSun"
                            FontSize="12"
                            Foreground="#555555"
                            Text="准考证号：" />
                        <TextBlock
                            x:Name="ExamNumberText"
                            FontFamily="Times New Roman"
                            FontSize="12"
                            Foreground="#333333" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="PreviousSpreadButton"
                        Click="PreviousSpreadButton_Click"
                        Content="‹"
                        FontFamily="Times New Roman"
                        FontSize="24"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="上一组试卷页" />
                    <TextBlock
                        x:Name="SpreadIndicatorText"
                        Width="112"
                        VerticalAlignment="Center"
                        FontFamily="Times New Roman,SimSun"
                        FontSize="13"
                        TextAlignment="Center" />
                    <Button
                        x:Name="NextSpreadButton"
                        Click="NextSpreadButton_Click"
                        Content="›"
                        FontFamily="Times New Roman"
                        FontSize="24"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="下一组试卷页" />
                </StackPanel>

                <Grid Grid.Column="2" HorizontalAlignment="Right">
                    <StackPanel
                        x:Name="ReadyPanel"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <CheckBox
                            x:Name="AgreeCheckBox"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Checked="AgreeCheckBox_Changed"
                            Content="我已阅读并同意考生守则"
                            FontSize="13"
                            Unchecked="AgreeCheckBox_Changed" />
                        <Button
                            x:Name="StartExamButton"
                            Click="StartExamButton_Click"
                            Content="领取试卷"
                            IsEnabled="False"
                            Style="{StaticResource SubmitButtonStyle}" />
                    </StackPanel>

                    <StackPanel
                        x:Name="RunningPanel"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#555555"
                            Text="已答 " />
                        <TextBlock
                            x:Name="AnsweredCountText"
                            VerticalAlignment="Center"
                            FontFamily="Times New Roman"
                            FontSize="14"
                            FontWeight="Bold" />
                        <TextBlock
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#555555"
                            Text="剩余 " />
                        <TextBlock
                            x:Name="TimeRemainingText"
                            Width="68"
                            VerticalAlignment="Center"
                            FontFamily="Times New Roman"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#A61F2B" />
                        <Button
                            Margin="12,0,0,0"
                            Click="SubmitExamButton_Click"
                            Content="交卷"
                            Style="{StaticResource SubmitButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer
                x:Name="PaperScrollViewer"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">
                    <StackPanel
                        x:Name="SpreadPanel"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Border Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="12"
                                    Direction="270"
                                    Opacity="0.18"
                                    ShadowDepth="3" />
                            </Border.Effect>
                            <paper:ExamPaperPageControl x:Name="LeftPageControl" />
                        </Border>
                        <Border Margin="10,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="12"
                                    Direction="270"
                                    Opacity="0.18"
                                    ShadowDepth="3" />
                            </Border.Effect>
                            <paper:ExamPaperPageControl x:Name="RightPageControl" />
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border
                x:Name="PaperAccessOverlay"
                Width="540"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F4F4F2"
                BorderBrush="#9C9C98"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Times New Roman,SimHei"
                        FontSize="21"
                        FontWeight="Bold"
                        Text="考生守则" />
                    <TextBlock
                        Margin="0,18,0,0"
                        FontFamily="Times New Roman,SimSun"
                        FontSize="15"
                        LineHeight="24"
                        Text="1. 答题前请核对考试科目、试卷类型和个人信息。&#x0a;2. 考试期间不得关闭窗口，不得借助未经允许的外部资料。&#x0a;3. 选择题直接点击选项，解答题应写出必要的作答过程。&#x0a;4. 考试时间结束后系统将自动交卷，交卷后答案不可修改。"
                        TextWrapping="Wrap" />
                    <Border
                        Margin="0,22,0,0"
                        Padding="14,10"
                        Background="#E2E2DF"
                        BorderBrush="#C1C1BD"
                        BorderThickness="1">
                        <TextBlock
                            FontFamily="Times New Roman,SimHei"
                            FontSize="14"
                            FontWeight="Bold"
                            Text="请在窗口右上角确认考生守则，确认后方可领取试卷。"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <Border
                x:Name="ResultOverlay"
                Width="460"
                Padding="34"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFEFB"
                BorderBrush="#B8B5AE"
                BorderThickness="1"
                Visibility="Collapsed">
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Times New Roman,SimHei"
                        FontSize="23"
                        FontWeight="Bold"
                        Text="考试成绩" />
                    <TextBlock
                        x:Name="ScoreText"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        FontFamily="Times New Roman"
                        FontSize="62"
                        FontWeight="Bold"
                        Foreground="#A61F2B" />
                    <TextBlock
                        x:Name="ScoreDetailText"
                        HorizontalAlignment="Center"
                        FontFamily="Times New Roman,SimSun"
                        FontSize="15" />
                    <UniformGrid Margin="0,18,0,0" Columns="3">
                        <TextBlock x:Name="CorrectCountText" TextAlignment="Center" />
                        <TextBlock x:Name="WrongCountText" TextAlignment="Center" />
                        <TextBlock x:Name="TimeUsedText" TextAlignment="Center" />
                    </UniformGrid>
                    <TextBlock
                        x:Name="EncouragementText"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <StackPanel
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Click="ReviewAnswersButton_Click"
                            Content="查看答案"
                            Style="{StaticResource SubmitButtonStyle}" />
                        <Button
                            Margin="12,0,0,0"
                            Click="RetryExamButton_Click"
                            Content="再考一次"
                            Style="{StaticResource ToolbarButtonStyle}" />
                        <Button
                            Margin="12,0,0,0"
                            Click="CloseExamButton_Click"
                            Content="关闭"
                            Style="{StaticResource ToolbarButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
