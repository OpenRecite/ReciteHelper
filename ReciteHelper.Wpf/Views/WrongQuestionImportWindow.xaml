<Window
    x:Class="ReciteHelper.Wpf.Views.WrongQuestionImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="导入错题"
    Width="920"
    Height="680"
    Background="#F5F7F9"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="26,22" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" Text="将错题导入项目" />
                <TextBlock
                    x:Name="SummaryText"
                    Margin="0,8,0,0"
                    FontSize="13"
                    Foreground="#64748B"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="26" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CandidatesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,12"
                            Padding="18"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Grid.Column="0"
                                    Margin="0,3,16,0"
                                    VerticalAlignment="Top"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="#0F172A"
                                        Text="{Binding Number, StringFormat='第{0}题'}" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontSize="13"
                                        Foreground="#1E293B"
                                        LineHeight="22"
                                        Text="{Binding Question.Text}"
                                        TextWrapping="Wrap" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Margin="0,0,8,0" Padding="10" Background="#F8FAFC" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="你的答案" />
                                                <TextBlock Margin="0,4,0,0" Foreground="#334155" Text="{Binding UserAnswer}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Margin="8,0,0,0" Padding="10" Background="#F0FDF4" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#15803D" Text="正确答案" />
                                                <TextBlock Margin="0,4,0,0" Foreground="#166534" Text="{Binding CorrectAnswer}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontSize="12"
                                        Foreground="#B45309"
                                        Text="{Binding DuplicateHint}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasSimilarQuestion, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,16" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Button Click="SelectAllButton_Click" Content="全选" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Margin="12,0,0,0" Click="ClearSelectionButton_Click" Content="全不选" Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Click="CancelButton_Click" Content="取消" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Margin="12,0,0,0" Click="ConfirmButton_Click" Content="确认导入" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
