<Page
    x:Class="ReciteHelper.DataCollect.Pages.Answer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ReciteHelper.DataCollect.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Answer"
    d:DesignHeight="600"
    d:DesignWidth="800"
    Background="White"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ScoreButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="45" />
            <Setter Property="Height" Value="45" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Background" Value="#E0E0E0" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="20,12"
            Background="#4A6FA5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="White"
                        Text="👤 " />
                    <TextBlock
                        x:Name="UserNameText"
                        VerticalAlignment="Center"
                        FontFamily="Arial"
                        FontSize="14"
                        Foreground="White" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="SimSun"
                        FontSize="12"
                        Foreground="#E3F2FD"
                        Text="任务编号：" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Arial"
                        FontSize="14"
                        Foreground="White"
                        Text="W60BZ2T" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30">
                <TextBlock
                    x:Name="ProgressText"
                    Margin="0,0,0,15"
                    FontFamily="SimSun"
                    FontSize="12"
                    Foreground="#666666" />

                <Border
                    Padding="25,20"
                    Background="#FAFAFA"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,12"
                            FontFamily="SimSun"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="题目内容" />
                        <Border
                            Height="1"
                            Margin="0,0,0,15"
                            Background="#E0E0E0" />
                        <TextBlock
                            x:Name="QuestionText"
                            FontFamily="SimSun"
                            FontSize="14"
                            LineHeight="24"
                            TextAlignment="Left"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,20,0,0"
                    Padding="25,20"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,12"
                            FontFamily="SimSun"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="您的答案" />
                        <Border
                            Height="1"
                            Margin="0,0,0,15"
                            Background="#E0E0E0" />

                        <TextBox
                            x:Name="AnswerTextBox"
                            MinHeight="100"
                            MaxHeight="150"
                            Padding="10"
                            AcceptsReturn="True"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            FontFamily="SimSun"
                            FontSize="14"
                            IsEnabled="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                    <ScrollViewer x:Name="PART_ContentHost" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button
                            x:Name="SubmitAnswerButton"
                            Width="100"
                            Height="30"
                            Margin="0,20,0,0"
                            Padding="25,12"
                            HorizontalAlignment="Right"
                            Background="#4A6FA5"
                            Click="SubmitAnswerButton_Click"
                            Content="确认答案"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="ReviewPanel"
                    Margin="0,20,0,0"
                    Padding="25,20"
                    Background="#F9F9F9"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock
                                Margin="0,0,0,10"
                                FontFamily="SimSun"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="正确答案" />
                            <Border
                                Height="1"
                                Margin="0,0,0,12"
                                Background="#E0E0E0" />
                            <TextBlock
                                x:Name="CorrectAnswerText"
                                FontFamily="SimSun"
                                FontSize="14"
                                Foreground="#2E7D32"
                                LineHeight="24"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="SimSun"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="请为本次回忆评分：" />

                                <Button
                                    Grid.Column="1"
                                    Padding="10,5"
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="HelpButton_Click"
                                    Content="❔ 评分标准"
                                    Cursor="Hand"
                                    FontFamily="SimSun"
                                    FontSize="11"
                                    Foreground="#4A6FA5">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <StackPanel
                                Margin="0,15,0,20"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="Score0Button"
                                    Click="ScoreButton_Click"
                                    Content="0"
                                    Style="{StaticResource ScoreButtonStyle}"
                                    Tag="0" />
                                <Button
                                    x:Name="Score1Button"
                                    Click="ScoreButton_Click"
                                    Content="1"
                                    Style="{StaticResource ScoreButtonStyle}"
                                    Tag="1" />
                                <Button
                                    x:Name="Score2Button"
                                    Click="ScoreButton_Click"
                                    Content="2"
                                    Style="{StaticResource ScoreButtonStyle}"
                                    Tag="2" />
                                <Button
                                    x:Name="Score3Button"
                                    Click="ScoreButton_Click"
                                    Content="3"
                                    Style="{StaticResource ScoreButtonStyle}"
                                    Tag="3" />
                                <Button
                                    x:Name="Score4Button"
                                    Click="ScoreButton_Click"
                                    Content="4"
                                    Style="{StaticResource ScoreButtonStyle}"
                                    Tag="4" />
                                <Button
                                    x:Name="Score5Button"
                                    Click="ScoreButton_Click"
                                    Content="5"
                                    Style="{StaticResource ScoreButtonStyle}"
                                    Tag="5" />
                            </StackPanel>

                            <TextBlock
                                x:Name="ScoreDescriptionText"
                                Margin="0,0,0,20"
                                HorizontalAlignment="Center"
                                FontFamily="SimSun"
                                FontSize="12"
                                Foreground="#666666"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />

                            <Button
                                x:Name="SubmitScoreButton"
                                Padding="25,12"
                                HorizontalAlignment="Center"
                                Background="#2E7D32"
                                Click="SubmitScoreButton_Click"
                                Content="提交评分并继续"
                                Cursor="Hand"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"
                                IsEnabled="False">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button" />
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border
                    x:Name="CompletionPanel"
                    Margin="0,20,0,0"
                    Padding="40,30"
                    Background="#E8F5E9"
                    BorderBrush="#4CAF50"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,15"
                            HorizontalAlignment="Center"
                            FontFamily="SimSun"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#2E7D32"
                            Text="🎉 今日题目已完成" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="SimSun"
                            FontSize="14"
                            LineHeight="24"
                            TextAlignment="Center"
                            TextWrapping="Wrap">
                            感谢您的支持与配合！今日所有题目已完成。<LineBreak />
                            数据已自动保存，您可以在明天继续参与。</TextBlock>
                        <Button
                            x:Name="FinishButton"
                            Margin="0,20,0,0"
                            Padding="30,12"
                            HorizontalAlignment="Center"
                            Background="#2E7D32"
                            Click="FinishButton_Click"
                            Content="完成"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White">
                            <Button.Style>
                                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button" />
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>