<Page
    x:Class="ReciteHelper.DataCollect.Pages.CollectInformation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ReciteHelper.DataCollect.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CollectInformation"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="White"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="60,30">

                <Viewbox
                    MaxHeight="40"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    Stretch="Uniform">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="华文中宋"
                        Text="信息采集" />
                </Viewbox>

                <TextBlock
                    Margin="0,0,0,30"
                    HorizontalAlignment="Center"
                    FontFamily="Times New Roman"
                    FontSize="16"
                    Foreground="#666666"
                    Text="Information Collection" />

                <TextBlock
                    Margin="0,0,0,25"
                    FontFamily="SimSun"
                    FontSize="13"
                    LineHeight="24"
                    Text="　　请提供以下基本信息，这将有助于我们更好地分析数据并提供个性化的反馈。所有信息将严格保密，仅用于后续的数据分析和建模应用。"
                    TextWrapping="Wrap" />

                <!--  表单区域  -->
                <Border
                    Padding="30,25"
                    Background="#F9F9F9"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="*" MinWidth="250" />
                        </Grid.ColumnDefinitions>

                        <!--  姓名  -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,15,20"
                            VerticalAlignment="Center"
                            FontFamily="SimSun"
                            FontSize="14"
                            Text="昵称：" />
                        <TextBox
                            x:Name="NameTextBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,20"
                            Padding="10,8"
                            VerticalContentAlignment="Center"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            FontFamily="SimSun"
                            FontSize="14"
                            TextChanged="Field_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                    <ScrollViewer x:Name="PART_ContentHost" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!--  邮箱  -->
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,15,20"
                            VerticalAlignment="Center"
                            FontFamily="SimSun"
                            FontSize="14"
                            Text="邮箱：" />
                        <TextBox
                            x:Name="EmailTextBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,20"
                            Padding="10,8"
                            VerticalContentAlignment="Center"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            FontFamily="Times New Roman"
                            FontSize="14"
                            TextChanged="Field_TextChanged">
                            <TextBox.Style>
                                <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox" />
                            </TextBox.Style>
                        </TextBox>

                        <!--  学科门类  -->
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,15,20"
                            VerticalAlignment="Center"
                            FontFamily="SimSun"
                            FontSize="14"
                            Text="学科门类：" />
                        <ComboBox
                            x:Name="DisciplineComboBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,20"
                            Padding="8,8"
                            VerticalContentAlignment="Center"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            FontFamily="SimSun"
                            FontSize="14"
                            SelectionChanged="Field_SelectionChanged">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                    <Grid>
                                                        <ToggleButton
                                                            x:Name="ToggleButton"
                                                            Background="Transparent"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                                        <ContentPresenter
                                                            x:Name="ContentSite"
                                                            Margin="10,2,30,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Content="{TemplateBinding SelectionBoxItem}"
                                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                                        <TextBox
                                                            x:Name="PART_EditableTextBox"
                                                            Margin="3,3,23,3"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="Transparent"
                                                            Focusable="True"
                                                            IsReadOnly="{TemplateBinding IsReadOnly}"
                                                            Style="{x:Null}"
                                                            Visibility="Hidden" />
                                                        <Popup
                                                            x:Name="Popup"
                                                            AllowsTransparency="True"
                                                            Focusable="False"
                                                            IsOpen="{TemplateBinding IsDropDownOpen}"
                                                            Placement="Bottom"
                                                            PopupAnimation="Slide">
                                                            <Grid
                                                                x:Name="DropDown"
                                                                MinWidth="{TemplateBinding ActualWidth}"
                                                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                                SnapsToDevicePixels="True">
                                                                <Border
                                                                    x:Name="DropDownBorder"
                                                                    Background="White"
                                                                    BorderBrush="#CCCCCC"
                                                                    BorderThickness="1" />
                                                                <ScrollViewer SnapsToDevicePixels="True">
                                                                    <StackPanel>
                                                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                                                    </StackPanel>
                                                                </ScrollViewer>
                                                            </Grid>
                                                        </Popup>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <!--  专业  -->
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,0,15,20"
                            VerticalAlignment="Center"
                            FontFamily="SimSun"
                            FontSize="14"
                            Text="具体专业：" />
                        <TextBox
                            x:Name="MajorTextBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,0,0,20"
                            Padding="10,8"
                            VerticalContentAlignment="Center"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            FontFamily="SimSun"
                            FontSize="14"
                            TextChanged="Field_TextChanged">
                            <TextBox.Style>
                                <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox" />
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,0,15,0"
                            VerticalAlignment="Top"
                            FontFamily="SimSun"
                            FontSize="14"
                            Text="工作单位：">
                            <TextBlock.ToolTip>
                                <ToolTip>
                                    <TextBlock
                                        FontFamily="SimSun"
                                        FontSize="12"
                                        Text="此字段仅用于提供致谢（如发表致谢部分），可选择填写" />
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <StackPanel Grid.Row="4" Grid.Column="1">
                            <TextBox
                                x:Name="WorkplaceTextBox"
                                Padding="10,8"
                                VerticalContentAlignment="Center"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                FontFamily="SimSun"
                                FontSize="14"
                                TextChanged="Field_TextChanged">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox" />
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock
                                Margin="5,5,0,0"
                                FontFamily="SimSun"
                                FontSize="11"
                                FontStyle="Italic"
                                Foreground="#666666"
                                Text="（可选，仅用于提供致谢）" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  按钮区域  -->
                <Grid Margin="0,30,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="NextButton"
                        Grid.Column="3"
                        Padding="25,10"
                        Background="#4A6FA5"
                        Click="NextButton_Click"
                        Content="下一步"
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        IsEnabled="False">
                        <Button.Style>
                            <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button" />
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>